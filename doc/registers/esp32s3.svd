<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <name>ESP32S3_RADIO</name>
  <version>0.1.0</version>
  <description>Undocumented ESP32-S3 radio registers as esp-sdr-zephyr knows them, additions to Espressif's SVD (github.com/espressif/svd at be20aa1): doc/registers/svdmerge.py merges them, doc/registers/svd2md.py renders doc/undocumented-registers-esp32s3.md. Peripherals in group ANALOG_I2C are analog I2C blocks, not memory-mapped: base address block &lt;&lt; 8, one 8-bit register per offset.</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <peripherals>
    <peripheral>
      <name>DUMP</name>
      <description>
        Dump and DAC engine
        The Wi-Fi MAC's debug dump engine moves raw baseband words between the radio
        and one 64 KiB SRAM bank (see "SRAM bank ownership"). Its page, 0x60033000,
        has no name in the HAL. Layout from upstream esp-sdr; the DAC side from
        librftest's `dactrig()`.

        **Wi-Fi MAC interrupt.** CPU interrupt line 0 (`ETS_WMAC_INUM`,
        `modules/hal/espressif/components/soc/esp32s3/include/soc/soc.h:212`);
        `esp_sdr_ring_run()` disables it on its CPU (hardware-quirks.md, "Capture and
        DAC engine"; `lib/esp_sdr/src/esp_sdr_ring.c:462-491`).
      </description>
      <baseAddress>0x60033000</baseAddress>
      <addressBlock>
        <offset>0xd5c</offset>
        <size>0x38</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CTRL</name>
          <description>
            Receive side: run, trigger and count of a capture
            With neither DUMP_RATE_16M nor DUMP_RATE_40M the engine captures at 80 MS/s (4096
            samples in 51 to 60 us). One-shot sequence: DUMP_CTRL_REG = 0, DUMP_CONFIG_REG, bank
            select, `DUMP_RUN | rate | count`, the same with DUMP_TRIGGER, the same without,
            poll DUMP_DONE, DUMP_CTRL_REG = 0, restore the bank select. The engine can stop
            early without any error flag (hardware-quirks.md, "Capture and DAC engine").
            Evidence: `lib/esp_sdr/src/esp_sdr_rx.c:246-326` (sequence),
            `lib/esp_sdr/src/esp_sdr_rx.c:287-293, 321-323` (early stop)
          </description>
          <addressOffset>0xd5c</addressOffset>
          <fields>
            <field>
              <name>RUN</name>
              <description>
                Enables the engine.
                Evidence: *working* `lib/esp_sdr/src/esp_sdr_rx.c:300-310`
              </description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TRIG_SEL</name>
              <description>
                The vendor `adctrig()`'s second argument: 0 = software trigger
                (DUMP_TRIGGER); 5 and 6 make it send frames while it waits. Seen 0.
                The trigger select could take work off the CPU; lead, not tried.
                Evidence: *decompile* S3 `mac_common.o`
                Evidence: *decompile* S3 `libphy.a` (lead)
              </description>
              <bitRange>[30:28]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SRC</name>
              <description>
                The vendor's third argument; upstream calls it the source. Seen 0.
                Evidence: *decompile* S3 `mac_common.o`; *upstream*
                `modules/lib/esp-sdr/main/targets/esp32s3/receiver.c:164`
              </description>
              <bitRange>[27:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TRIGGER</name>
              <description>
                Write 1, then 0, to start a one-shot capture.
                Evidence: *working* `lib/esp_sdr/src/esp_sdr_rx.c:308-310`
              </description>
              <bitRange>[19:19]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>DONE</name>
              <description>
                Reads 1 once DUMP_COUNT words are written; the library gives up after 20 ms.
                Evidence: *working* `lib/esp_sdr/src/esp_sdr_rx.c:311-314`
              </description>
              <bitRange>[18:18]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>CIRCULAR</name>
              <description>
                With DUMP_RUN and no trigger, the engine writes continuously round a
                16384-pair ring (0x00024000 = this bit plus count 16384). In `adctrig()`
                the same bit skips the final count check.
                Evidence: *working* `lib/esp_sdr/src/esp_sdr_ring.c:41-42, 876-881`;
                *decompile* S3 `mac_common.o`
              </description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RATE_16M</name>
              <description>
                Separate 16 MS/s path: 4096 samples in 256 us. `adctrig()` sets it unless
                bit 0 of its fourth argument is set.
                Evidence: *measured* `apps/capture/README.rst:56`; *upstream* (USRP B210)
                `modules/lib/esp-sdr/main/targets/esp32s3/receiver.c:161-163`; *decompile*
                S3 `mac_common.o`
              </description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RATE_40M</name>
              <description>
                80 MS/s halved, through the radio's decimation filter (each symbol spread
                over about +-8 samples, same MER as 80 MS/s): 4096 samples in 102 us.
                Evidence: *measured* `apps/capture/README.rst:53`, hardware-quirks.md,
                "Receiving at 40 MS/s"
              </description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>COUNT</name>
              <description>
                Words to capture, 256 to 16380. The library uses bits 13:0 (at most 16380,
                `ESP_SDR_SAMPLES_MAX`); `adctrig()` writes count + 1 and checks a 15-bit
                written count, and the ring writes 16384 (bit 14), so the field is probably
                15 bits wide.
                Evidence: *working* `lib/esp_sdr/src/esp_sdr_priv.h:33`; *decompile* S3
                `mac_common.o`
              </description>
              <bitRange>[14:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WRITE_INDEX</name>
          <description>
            Words written by a capture; the live write index in circular mode
            No read pointer is known for the DAC side; loop playback runs open loop on
            CCOUNT.
            Evidence: *measured* `lib/esp_sdr/src/esp_sdr_priv.h:236-244` (no DAC read pointer)
          </description>
          <addressOffset>0xd60</addressOffset>
          <fields>
            <field>
              <name>WRITE_INDEX</name>
              <description>
                Words written, a 15-bit value: after DUMP_DONE, `adctrig()` compares it with
                count + 1. In circular mode bits 13:0 are the live write index, mod 16384,
                advancing whichever bank is selected; the ring times its bank switches on it.
                Evidence: *decompile* S3 `mac_common.o` (words written)
                Evidence: *working* `lib/esp_sdr/src/esp_sdr_ring.c:40, 116-119`; *upstream*
                `modules/lib/esp-sdr/main/common/ring_capture.c:112` (circular mode)
              </description>
              <bitRange>[14:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DAC_TRIG</name>
          <description>
            Transmit side: run, trigger and count of a playback
            8 bytes above DUMP_CTRL_REG.

            - Writing 0 stops the engine at once (`esp_sdr_dac_halt()`).
            - In loop mode the DAC clock is exact (CPU stores to other banks do not slow
              it) and the engine reads whichever bank is selected at the moment, so a bank
              switch takes effect mid-pass.
            - The vendor's `dactrig(count, a2, a3, ...)` fills bank 2 (0x3fcd0000) with a
              ramp, writes count to DUMP_DAC_COUNT and bits 27:20, sets DUMP_DAC_RATE_80M
              unless a2 is 1, sets DUMP_DAC_TRIGGER (and leaves it set) only if a3 is not 0,
              sets DUMP_DAC_RUN, polls its own DUMP_DAC_DONE, waits 10 ms and clears
              DUMP_CTRL_REG (0x60033d5c), not itself. It never writes the bank select. The
              library skips the ramp so the caller's samples survive, and clears
              DUMP_CTRL_REG after every transmit session as well.
            - The front end must be forced to transmit, or only a spur near -6 MHz leaks
              (FE_FORCE_TXON, see "Front end").
            Evidence: *measured* `lib/esp_sdr/src/esp_sdr_priv.h:236-244` (loop mode)
            Evidence: *decompile* S3 `mac_common.o` (`dactrig()`)
            Evidence: `lib/esp_sdr/src/esp_sdr_tx.c:222-223, 311-312` (the library skips the ramp, clears DUMP_CTRL_REG)
          </description>
          <addressOffset>0xd64</addressOffset>
          <fields>
            <field>
              <name>DAC_RUN</name>
              <description>
                Run bit; `dactrig()` sets it.
                Evidence: *working* `lib/esp_sdr/src/esp_sdr_tx.c:146-156`
              </description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>B27_20</name>
              <description>
                `dactrig()` writes count &amp; 0xff here; no effect on the rate.
                Evidence: *measured* `lib/esp_sdr/src/esp_sdr_priv.h:46-48`; *decompile* S3
                `mac_common.o`
              </description>
              <bitRange>[27:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC_TRIGGER</name>
              <description>
                Pulsed: one pass. Held: the engine replays the first DUMP_DAC_COUNT words
                back to back, gapless, until the register is cleared. A retrigger leaves a
                hole of about 1.35 us.
                Evidence: *measured* `lib/esp_sdr/src/esp_sdr_tx.c:197-199, 292-302`,
                `lib/esp_sdr/src/esp_sdr_priv.h:236-244`
              </description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC_DONE</name>
              <description>
                Done flag; `dactrig()` polls it.
                Evidence: *working* `lib/esp_sdr/src/esp_sdr_tx.c:158-167`
              </description>
              <bitRange>[18:18]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>B16</name>
              <description>
                No effect on the rate: there is no 16 MS/s DAC rate.
                Evidence: *measured* `lib/esp_sdr/src/esp_sdr_priv.h:46-48`
              </description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC_RATE_80M</name>
              <description>
                The DAC has its own clock: 1 = 80 MS/s, 0 = 40 MS/s. 40 MS/s gives about
                4 dB less MER.
                Evidence: *measured* `lib/esp_sdr/src/esp_sdr_priv.h:46-49`, hardware-quirks.md
              </description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC_COUNT</name>
              <description>
                Words to play, 256 to 16380.
                Evidence: *working* `lib/esp_sdr/src/esp_sdr_tx.c:148-149`
              </description>
              <bitRange>[13:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CONFIG</name>
          <description>
            Lane selectors: the sources packed into a dump word
            Four 6-bit lane selectors (lane n in bits 6n+5:6n) choose the internal sources
            packed into a dump word; 0x000c2040 selects sources 0, 1, 2, 3: receive I/Q.
            librftest's `mac_init()` writes 0x000c2040 here once; the library writes it
            before every capture and ring run. The reading as lane selectors is upstream's.

            Only sources 0 to 3 are ever used. The others could take work off the CPU;
            lead, not tried.
            Evidence: *working* `lib/esp_sdr/src/esp_sdr_priv.h:34-36`; *upstream*
            `modules/lib/esp-sdr/main/targets/esp32s3/receiver.c:159` (lane selectors)
            Evidence: *decompile* S3 `mac_common.o` (`mac_init()`)
            Evidence: *decompile* S3 `libphy.a` (lead)
          </description>
          <addressOffset>0xd90</addressOffset>
          <fields>
            <field>
              <name>RX_AGC</name>
              <description>
                Upstream probe flag (`rx_agc`). Seen 0.
                Evidence: *upstream* `modules/lib/esp-sdr/main/targets/esp32s3/receiver.c:159`
              </description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LANE3</name>
              <description>
                Source of lane 3; 3 for receive I/Q.
              </description>
              <bitRange>[23:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LANE2</name>
              <description>
                Source of lane 2; 2 for receive I/Q.
              </description>
              <bitRange>[17:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LANE1</name>
              <description>
                Source of lane 1; 1 for receive I/Q.
              </description>
              <bitRange>[11:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>LANE0</name>
              <description>
                Source of lane 0; 0 for receive I/Q.
              </description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SENSITIVE</name>
      <version>espressif/svd be20aa1</version>
      <description>
        SRAM bank ownership
      </description>
      <baseAddress>0x600c1000</baseAddress>
      <addressBlock>
        <offset>0x1c</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>INTERNAL_SRAM_USAGE_3</name>
          <description>
            Hands SRAM banks to the dump engine
            The banks by field bit:

            | Bit | Bank | Use in esp_sdr |
            |---|---|---|
            | 0 | 0x3fcb0000, 64 KiB | ring (`CONFIG_ESP_SDR_RING`) |
            | 1 | 0x3fcc0000 | second DAC and capture bank (`CONFIG_ESP_SDR_BANK1`), ring |
            | 2 | 0x3fcd0000 | capture bank; the one `adctrig()` and `dactrig()` use |
            | 3 | 0x3fce0000 | never: it holds ROM data |

            The library saves the register and restores it after each use. Undocumented
            behaviour:

            - While the engine owns a bank the CPUs cannot reach any of it, so nothing else
              may live there; the linker snippets reserve the banks and lower
              `_heap_sentry`.
            - CPU stores reach the DAC only if made while the CPU owns the bank; otherwise
              the DAC replays the old content.
            - The engine follows a change of the field while it runs, in both directions:
              the ring splits one continuous capture into gapless units, the DAC switches
              banks mid-pass.
            - Bank 3 holds ROM data (0x3fceffxx); handing it to the engine wedges the
              board, USB and shell die.
            Evidence: `lib/esp_sdr/src/esp_sdr_rx.c:246-278`, `lib/esp_sdr/src/esp_sdr.c:123-133`
            (save and restore)
            Evidence: `lib/esp_sdr/esp_sdr_bank_ring.ld:4-14` (reserved banks)
            Evidence: *measured* `lib/esp_sdr/src/esp_sdr_tx.c:392-396` (CPU stores and the DAC)
            Evidence: *measured* hardware-quirks.md, "Capture and DAC engine";
            `lib/esp_sdr/src/esp_sdr_priv.h:236-244` (a change while running)
            Evidence: *measured* bench 2026-10-05, `lib/esp_sdr/esp_sdr_bank.ld`; *upstream*
            `modules/lib/esp-sdr/main/common/ring_capture.h:26` (bank 3)
          </description>
          <addressOffset>0x1c</addressOffset>
          <fields>
            <field>
              <name>INTERNAL_SRAM_MAC_DUMP_USAGE</name>
              <description>
                One-hot: bit n hands bank n to the engine, for capture and playback alike;
                0 gives every bank back to the CPUs. The HAL defines the field without a
                description.
                Evidence: `modules/hal/espressif/components/soc/esp32s3/register/soc/sensitive_reg.h:101-107`
              </description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>AGC</name>
      <description>
        AGC force
      </description>
      <baseAddress>0x6001c000</baseAddress>
      <addressBlock>
        <offset>0x2c</offset>
        <size>0x58</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>FORCE</name>
          <description>
            Forced receive gain index, force bit and largest calibrated index
            Upstream calls the register AGCPWR_CTRL7. The PHY's `rom_agc_reg_init()` pulses
            AGC_FORCE_EN (bit 23) with index 0x32. The ESP32-C6 has the same layout. Levels
            with a 50 ohm load: AGC -25.7, index 0 -46.0, 40 -39.0, 60 -27.0,
            82 -19.9 dBFS.

            - `force_rx_gain(force, index, 0)` also calls `bt_rx_force(0)`, which clears
              AGC_R80_REG bits 7:6 and steps FE_R110_REG bits 9:8 through 2, 3 and 0.
            - A forced gain is occasionally lost; this register does not show it
              (hardware-quirks.md, "The forced receive gain gets lost").
            - A new forced index alone can leave stale receive state, so a gain change
              reruns the front-end setup.
            Evidence: *decompile* S3 `phy_reg.o` (`rom_agc_reg_init()`)
            Evidence: *measured* bench 2026-10-05 (levels)
            Evidence: *decompile* S3 `phy_test.o` (`bt_rx_force(0)`)
            Evidence: *upstream* `modules/lib/esp-sdr/main/targets/esp32s3/receiver.c:107-113`;
            `lib/esp_sdr/src/esp_sdr_rx.c:164-166` (gain change)
          </description>
          <addressOffset>0x2c</addressOffset>
          <fields>
            <field>
              <name>FORCE_INDEX</name>
              <description>
                Forced receive gain index.
                Evidence: *decompile* S3 `phy_test.o`; *working*
              </description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FORCE_EN</name>
              <description>
                Force: 1 holds the index, 0 hands the gain to the AGC.
                Evidence: *decompile* S3 `phy_test.o`; *working*
              </description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>GAIN_MAX</name>
              <description>
                Largest calibrated gain index, 0 to 82, written by the PHY when it builds
                the gain table (capped at 82). Larger reads point at uncalibrated slots; the
                library treats them as 0.
                Evidence: *working* `lib/esp_sdr/src/esp_sdr_rx.c:29-34`; *decompile* S3
                `phy_rx_gain.o`; *upstream* `modules/lib/esp-sdr/main/common/burst_gain.h:1-4, 29-37`
              </description>
              <bitRange>[14:8]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>R6C</name>
          <description>
            AGC RSSI; lead, not tried
          </description>
          <addressOffset>0x6c</addressOffset>
          <fields>
            <field>
              <name>RSSI</name>
              <description>
                AGC RSSI. With the CCA busy counters (BB_CCA_BUSY_CNT0_REG to
                BB_CCA_BUSY_CNT2_REG) a candidate for 802.15.4 energy detection and CCA,
                work it could take off the CPU; lead, not tried.
                Evidence: *decompile* S3 `libphy.a`
              </description>
              <bitRange>[15:8]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>R80</name>
          <description>
            Unknown; bits 7:6 cleared by `bt_rx_force(0)`
          </description>
          <addressOffset>0x80</addressOffset>
          <fields>
            <field>
              <name>B7_6</name>
              <description>
                Cleared by `bt_rx_force(0)`, which `force_rx_gain(force, index, 0)` calls
                (see AGC_FORCE_REG).
                Evidence: *decompile* S3 `phy_test.o`
              </description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>FE</name>
      <description>
        Front end
        The FE block, `DR_REG_FE_BASE` 0x60006000: the HAL has the base, no registers.
      </description>
      <baseAddress>0x60006000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x178</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>TX_CTRL</name>
          <description>
            Force TX on and the TX gain memory index
            The library calls `force_txon_mode(1, 0, 0)` and `force_tx_gain()`, which writes
            gain memory slot 0. That this is the slot the front end then uses holds only
            while FE_BASE_INDEX reads 0; the code does not check it.
            Evidence: `lib/esp_sdr/src/esp_sdr_priv.h:164-169` (slot 0)
          </description>
          <addressOffset>0x0</addressOffset>
          <fields>
            <field>
              <name>BASE_INDEX</name>
              <description>
                Base index, read by `force_txon_mode()` and by the tone generator.
                Evidence: *decompile*
              </description>
              <bitRange>[25:18]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TX_GAIN_INDEX</name>
              <description>
                TX gain memory index (inferred). `force_txon_mode(en, mode, ofs)` writes
                `(ofs + (mode ? 16 : 0) + bits[25:18]) &amp; 0xff`; the tone generator writes
                `bits[25:18] + 9`.
                Evidence: *decompile* S3 `phy_test.o`, `phy_feature.o`
              </description>
              <bitRange>[17:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FORCE_TXON</name>
              <description>
                Force TX on. Without a frame in flight the MAC never enables the
                transmitter; `force_txon_mode(1, ...)` sets the bit, `(0, ...)` clears it,
                the vendor tone generator does the same. Without it only a spur near -6 MHz
                leaks; with it a tone stands 35 to 37 dB over the TX-off noise.
                Evidence: *measured* bench 2026-10-05; *working*
                `lib/esp_sdr/src/esp_sdr_tx.c:84-87`, `lib/esp_sdr/src/esp_sdr_rx.c:84-86`;
                *decompile* S3 `phy_test.o`, `phy_feature.o`
              </description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>R100</name>
          <description>
            Unknown; bits 18:16 listed by upstream's filter probe
          </description>
          <addressOffset>0x100</addressOffset>
          <fields>
            <field>
              <name>B18_16</name>
              <description>
                Unknown; listed by upstream's filter probe. Could not be written from the
                shell (`devmem`).
                Evidence: *measured* bench 2026-10-06; *speculative*
                `modules/lib/esp-sdr/main/diagnostics/filter_probe.h:19-20`
              </description>
              <bitRange>[18:16]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>R110</name>
          <description>
            Unknown; written by `force_txon_mode()` and `bt_rx_force(0)`
          </description>
          <addressOffset>0x110</addressOffset>
          <fields>
            <field>
              <name>B13_12</name>
              <description>
                3 when `force_txon_mode()`'s mode is not 0, else 0.
                Evidence: *decompile* S3 `phy_test.o`
              </description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>B9_8</name>
              <description>
                Stepped 0x200, 0x300, 0 (2, 3 and 0 in the field) by `bt_rx_force(0)`,
                which `force_rx_gain(force, index, 0)` calls (see AGC_FORCE_REG).
                Evidence: *decompile* S3 `phy_test.o`
              </description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IQ_EST_CONF0</name>
          <description>
            IQ estimator configuration; lead, not tried
            The vendor's `ram_iq_est_enable()` configures the IQ estimator in
            FE_IQ_EST_CONF0_REG and FE_IQ_EST_CONF1_REG (count up to 0x7fff); its done flag
            is FE_IQ_EST_DONE. It gives power, DC and a quadrature correlation against the
            transmit tone generator, work it could take off the CPU.
            Evidence: *decompile* S3 `libphy.a`
          </description>
          <addressOffset>0x140</addressOffset>
        </register>
        <register>
          <name>IQ_EST_CONF1</name>
          <description>
            IQ estimator configuration; lead, not tried
            Configured together with FE_IQ_EST_CONF0_REG; see there.
            Evidence: *decompile* S3 `libphy.a`
          </description>
          <addressOffset>0x144</addressOffset>
        </register>
        <register>
          <name>R174</name>
          <description>
            IQ estimator done flag; lead, not tried
          </description>
          <addressOffset>0x174</addressOffset>
          <fields>
            <field>
              <name>IQ_EST_DONE</name>
              <description>
                Done flag of the IQ estimator (see FE_IQ_EST_CONF0_REG).
                Evidence: *decompile* S3 `libphy.a`
              </description>
              <bitRange>[16:16]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
