              <access>read-write</access>
            </field>
            <field>
              <name>BLK68</name>
              <description>
                Block 0x68; 1 = master 0, 0 = master 1.
              </description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DIG</name>
              <description>
                Block 0x6d (`i2c_dig_reg`); 1 = master 0, 0 = master 1.
              </description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BIAS</name>
