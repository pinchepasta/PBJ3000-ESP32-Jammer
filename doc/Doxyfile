#
# API reference of the esp_sdr library (include/esp_sdr/). Run "doxygen" in
# this directory; the HTML lands in _build_doxygen/html. Only settings that
# differ from Doxygen's defaults are listed ("doxygen -x" shows them).

PROJECT_NAME           = "esp-sdr-zephyr"
PROJECT_BRIEF          = "Raw I/Q receive and transmit on the ESP32-S3/C6 Wi-Fi radio, for Zephyr"
OUTPUT_DIRECTORY       = _build_doxygen
STRIP_FROM_PATH        = ../include
STRIP_FROM_INC_PATH    = ../include
OPTIMIZE_OUTPUT_FOR_C  = YES
TAB_SIZE               = 8
TYPEDEF_HIDES_STRUCT   = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
SHOW_HEADERFILE        = YES

WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = YES
WARN_FORMAT            = "$file:$line: $text"

INPUT                  = _doxygen/main.md \
                         _doxygen/groups.dox \
                         ../include
FILE_PATTERNS          = *.h *.md *.dox
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = _doxygen/main.md

GENERATE_HTML          = YES
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_DYNAMIC_MENUS     = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO

# Document every declaration, whatever the SoC and Kconfig choices compile in:
# the headers say which configuration each part needs.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = CONFIG_SOC_SERIES_ESP32S3=1 \
                         CONFIG_ESP_SDR_TX=1 \
                         CONFIG_ESP_SDR_TX_DAC=1 \
                         CONFIG_ESP_SDR_BANK1=1 \
                         CONFIG_ESP_SDR_RING=1 \
                         "__attribute__(x)="
HAVE_DOT               = NO
